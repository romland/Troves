{
	"name": "Troves",
	"version": "0.9.0",
	"private": true,
	"scripts": {
		"start": "node server.js",
		"dev": "vite dev --host",
		"build": "vite build",
		"bundle": "./bin/bundle.sh",
		"inspect": "node --inspect=0.0.0.0:9229 node_modules/vite/bin/vite.js dev --host",
		"preview": "vite preview",
        "deploy": "bash ./bin/deploy.sh",
        "logs": "bash ./bin/logs.sh",
		"createuser": "npx tsx scripts/create-user.ts",
		"deleteallincontainer": "npx tsx scripts/empty-container.ts",
		"updatedbschema": "npx tsx scripts/teardown-fts.ts && npx prisma db push && npx prisma generate",
		"editdb": "npx prisma studio",
		"migrate:webp": "npx tsx scripts/convert-to-webp.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"generate-favicon": "convert t-as-in-troves-48x48.png -define icon:auto-resize=48,32,16 favicon.ico",
		"generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 static/troves512.webp",
		"paddleocr:build": "docker compose up -d --build paddleocr",
		"singlefile:build": "docker compose up -d --build singlefile",
		"services:build": "docker compose up -d --build",
		"services:up": "docker compose up -d",
		"services:down": "docker compose down",
		"services:logs": "docker compose logs -f",
		"docker:build": "docker compose --profile full up -d --build",
		"docker:up": "docker compose --profile full up -d",
		"vacuumdb": "sqlite3 prisma/dev.db \"VACUUM;\""
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"devDependencies": {
		"@faker-js/faker": "^10.6.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/typography": "^0.5.9",
		"@types/bcrypt": "^5.0.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/cheerio": "^0.22.35",
		"@types/color-namer": "^1.3.3",
		"@types/jsdom": "^28.0.3",
		"@types/marked": "^6.0.0",
		"@types/natural": "^5.1.5",
		"@types/node": "^20.6.0",
		"@types/pdf-parse": "^1.1.5",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"autoprefixer": "^10.4.13",
        "bcryptjs": "^2.4.3",
		"daisyui": "^4.4.18",
		"marked": "^11.0.0",
		"postcss": "^8.4.20",
		"prisma": "^5.0.0",
		"slugify": "^1.6.5",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.4",
		"tailwindcss": "^3.3.2",
		"ts-node": "^10.9.1",
		"tslib": "^2.4.1",
		"tsx": "^4.6.2",
		"typescript": "^5.2.2",
		"vite": "^8.2.0",
		"vite-plugin-mkcert": "^1.17.12"
	},
	"type": "module",
	"dependencies": {
		"@google/genai": "^2.15.0",
		"@prisma/client": "^5.0.0",
		"@vitejs/plugin-basic-ssl": "^2.3.0",
		"better-sqlite3": "^13.0.3",
		"canvas": "^2.11.2",
		"cheerio": "^1.2.0",
		"color-namer": "^1.4.0",
		"colorthief": "^2.4.0",
		"crop-node": "^2.1.0",
		"dompurify": "^3.0.9",
		"epubjs": "^0.3.93",
		"exif-reader": "^2.0.3",
		"express": "^4.22.2",
		"form-data": "^4.0.0",
		"groq-sdk": "^0.3.2",
		"jsdom": "^25.0.0",
		"jsqr": "^1.4.0",
		"jszip": "^3.10.1",
		"natural": "^8.1.1",
		"node-fetch": "^3.3.2",
		"openai": "^4.28.0",
		"pdf-parse": "^2.4.5",
		"replicate": "^0.25.2",
		"sharp": "^0.35.3"
	},
	"overrides": {
		"@xmldom/xmldom": "^0.8.13",
		"cookie": "^0.7.0",
		"qs": "^6.14.1",
		"esbuild": "^0.25.0",
		"tar": "^7.5.21",
		"form-data": "^4.0.0",
		"tough-cookie": "^4.1.3",
		"uuid": "^11.1.1",
		"colorthief": {
			"sharp": "$sharp"
		},
		"ndarray-pixels": {
			"sharp": "$sharp"
		},
		"@vite-pwa/assets-generator": {
			"sharp": "$sharp"
		}
	}
}
