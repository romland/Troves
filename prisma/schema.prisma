generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // `https://github.com/prisma/prisma/issues/11789#issuecomment-1900773221
  // url      = "file:./dev.db?connection_limit=1"
  // url      = "file:./v2.db?connection_limit=1"
  // above undone by: https://github.com/prisma/prisma-engines/pull/4907
  url      = "file:./dev.db"
}


// ==========================================
// 1. IDENTITY & ACCESS MANAGEMENT (IAM)
// ==========================================

model User {
  id       Int     @id @unique @default(autoincrement())
  username String  @unique
  password String
  email    String? @unique
  name     String?
  avatar   String?
  isAdmin  Boolean @default(false) // Determines if user can create other local accounts
  canCreateInventories Boolean @default(true) // Determines if user can create new Troves
  preferences String? // JSON object storing keymaps and UI prefs

  // Auditing: Who created what
  items         Item[]
  timelineNotes TimelineNote[]

  // Security: Which vaults this user can open
  inventoryAccess UserInventoryAccess[]
  sessions        Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id           String   @id @unique @default(uuid())
  sessionHash  String   @unique
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ipAddress    String?
  lastActiveAt DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

model UserInventoryAccess {
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  
  // Roles: "OWNER" (can delete inventory, manage users), "EDITOR" (can add/edit items), "VIEWER" (read-only)
  role        String    @default("EDITOR") 

  // A user can only have one specific role per inventory
  @@id([inventoryId, userId])
}

// ==========================================
// 2. THE VAULT (THE INVENTORY)
// ==========================================
// Everything below this point MUST trace back to an Inventory.

model Inventory {
  id                  Int      @id @unique @default(autoincrement())
  name                String
  description         String
  classes             String  // JSON array of ML classes, e.g. ["shoes", "clothes"]
  archetype           String  @default("generic") // "media", "apparel", "hardware", "consumables", "collectibles", "natural", "generic"
  allowNewCategories  Boolean @default(true) // Whether AI is allowed to invent new sub-categories
  allowAutoTaxonomy   Boolean @default(false) // Whether AI is allowed to auto-generate taxonomy/EAV rules
  extractExif         Boolean @default(true) // Whether to extract EXIF data from uploaded photos in this vault
  deepScanCollections Boolean @default(false) // Whether to run individual AI analysis on items imported via multi-scan
  bgRemovalEnabled    Boolean @default(true) // Whether to run background removal
  bgRemovalModel      String  @default("bria-rmbg") // Which model to use: "bria-rmbg", "u2net", etc
  bgRemovalPreCrop    Boolean @default(false) // Whether to crop to foreground box BEFORE background removal
  enablePaddleOCR     Boolean @default(false) // Whether to extract text from images using local PaddleOCR container
  duplicateStrategy   String  @default("PROMPT") // "PROMPT", "AUTO_BUMP", "AUTO_IGNORE"
  archiveSingleScans  Boolean @default(false) // Whether to automatically archive single scans to the Notebook
  trackQuantity       Boolean @default(true) // Whether this trove uses quantities/stock
  showExif            Boolean @default(false) // Show EXIF data in item details
  showColors          Boolean @default(false) // Show extracted colors in item details
  showOcr             Boolean @default(true) // Show OCR text blocks in item details
  enableAskAi         Boolean @default(true) // Whether the Ask Troves is enabled
  enableNotebook      Boolean @default(true) // Whether the Notebook/Timeline is enabled
  showNoteContextUrl  Boolean @default(true) // Show the context URL captured with quick notes
  enableDocuments     Boolean @default(true) // Whether Documents/Links are enabled for items
  notebookCategories  String  @default("[\"idea\", \"todo\", \"to buy\", \"to read\", \"other\", \"archive\"]")
  enableFuzzySearch   Boolean @default(true) // Whether to use NLP stemming/fuzzy matching in search
  showRelatedItems    Boolean @default(false) // Show similar/related items at bottom of item page
  containerMode       String  @default("scan") // "scan" or "select" - defaults selector to camera or list
  defaultView         String  @default("grid") // "grid" or "list"
  templateFields      TemplateField[]

  users               UserInventoryAccess[]
  items               Item[]
  categories          Category[]
  containers          Container[]
  tags                Tag[]
  notes               TimelineNote[]

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ==========================================
// 3. ORGANIZATIONAL ENTITIES
// ==========================================

model Category {
  id          Int      @id @unique @default(autoincrement())
  name        String
  slug        String
  description String?
  duplicateStrategy String @default("PROMPT") // "PROMPT", "AUTO_BUMP", "AUTO_IGNORE"
  templateFields TemplateField[]

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId Int

  photos      Photo[]

  // Security: Category names are only unique *inside* their specific vault
  @@unique([inventoryId, name])
  @@unique([inventoryId, slug])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Container {
  id          Int      @id @unique @default(autoincrement())
  name        String   // e.g. "A 001"
  description String
  location    String?
  photoPath   String?
  spatialMap  String? // JSON storing [ [x1,y1], [x2,y2], [x3,y3], [x4,y4] ] + deskew matrix

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId Int

  parentId    Int?
  parent      Container?  @relation("ParentRelation", fields: [parentId], references: [id], onDelete: Cascade)
  children    Container[] @relation("ParentRelation")

  items       ItemsInContainer[]

  // Security: Container names are only unique *inside* their specific vault
  @@unique([inventoryId, name])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id          Int      @id @unique @default(autoincrement())
  name        String
  slug        String

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId Int

  items       Item[]

  // Security: Tag slugs are only unique *inside* their specific vault
  @@unique([inventoryId, name])
  @@unique([inventoryId, slug])
}

// ==========================================
// 4. CORE DATA (ITEMS & NOTES)
// ==========================================

model Item {
  id          Int      @id @unique @default(autoincrement())
  clientId    String?  @unique
  slug        String
  amount      Int?
  title       String?
  description String?
  reason      String?
  duplicateStatus String @default("NONE") // "NONE", "FLAGGED", "DISMISSED"
  semanticTokens String?

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId Int

  author      User      @relation(fields: [authorId], references: [id])
  authorId    Int

  photos      Photo[]
  documents   Document[]
  tags        Tag[]
  locations   ItemsInContainer[]
  attributes  KVP[]
  usage       InUse[]
  logs        ActivityLog[]
  timelineNotes TimelineNote[] @relation("TimelineNoteToItem")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimelineNote {
  id          Int      @id @unique @default(autoincrement())
  content     String?  
  referenceUrl String?
  latitude    Float?   
  longitude   Float?
  category    String?  @default("idea") // 'idea', 'todo', 'to buy', 'other', 'archive'

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId Int

  author      User      @relation(fields: [authorId], references: [id])
  authorId    Int

  photos      Photo[]
  documents   Document[]
  linkedItems Item[]   @relation("TimelineNoteToItem")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// 5. JOINS & SUB-ENTITIES
// ==========================================
// These don't need direct Inventory IDs because they are inextricably linked 
// to an Item or Note, which guarantees their silo.

model ItemsInContainer {
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      Int       
  container   Container @relation(fields: [containerId], references: [id], onDelete: Cascade)
  containerId Int
  spatialMap  String? // JSON storing [ [x1,y1], [x2,y2], [x3,y3], [x4,y4] ] for fluid items (clothes/books)

  // Replaced string references with strict Integer IDs
  @@id([itemId, containerId])
}

model Photo {
  id          Int      @id @unique @default(autoincrement())
  type        String   @default("product")
  isPrimary   Boolean  @default(false)
  orgPath     String?
  cropPath    String?
  thumbPath   String?
  ocr         String?
  showOriginal Boolean @default(false)
  colors      String?  
  classBlip   String?  
  classTrash  String?  
  llmAnalysis String?  
  exifData    String?

  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  Int?

  item        Item?     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      Int?

  timelineNote TimelineNote? @relation(fields: [timelineNoteId], references: [id], onDelete: Cascade)
  timelineNoteId Int?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Document {
  id          Int      @id @unique @default(autoincrement())
  type        String?  
  title       String
  source      String   
  path        String
  extracts    String   
  summary     String?  
  thumbPath   String?  

  item        Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      Int?

  timelineNote TimelineNote? @relation(fields: [timelineNoteId], references: [id], onDelete: Cascade)
  timelineNoteId Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KVP {
  id     Int    @id @unique @default(autoincrement())
  key    String
  value  String
  isAutoGenerated Boolean @default(false)

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId Int
}

// ==========================================
// 6. DYNAMIC TAXONOMY ENGINE
// ==========================================
model TemplateField {
  id          Int      @id @unique @default(autoincrement())
  name        String
  uiLabel     String   @default("Attribute")
  type        String   @default("string") // "string", "enum", "boolean", "number"
  options     String?  // JSON array for enums, e.g. '["Red", "Blue"]'
  matchWeight String   @default("FUZZY_SECONDARY") // "STRICT_DEDUPE", "FUZZY_SECONDARY", "METADATA_ONLY"
  extractionMethod String @default("HYBRID") // "VISION_STRICT", "HUMAN_REQUIRED", "HYBRID"

  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId Int

  category    Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId  Int?

  @@unique([inventoryId, categoryId, name])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Be able to tag items that are in use by/on something
// TODO: I believe this needs to be redefined to many->many as we can have several individual items
model InUse {
  id          Int      @id @unique @default(autoincrement())
  title       String?  
  description String?  

  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId      Int

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActivityLog {
  id        Int      @id @unique @default(autoincrement())
  level     String   @default("info")
  action    String
  message   String
  payload   String?
  
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId    Int?
  
  createdAt DateTime @default(now())
}

// ==========================================
// 7. SYSTEM TELEMETRY & METRICS
// ==========================================
model SystemMetric {
  id          Int      @id @unique @default(autoincrement())
  category    String   // e.g., 'MODEL_USAGE', 'SYSTEM_IO'
  provider    String   // e.g., 'gemini', 'groq', 'openai'
  operation   String?  // e.g., 'analyzePhoto', 'guessProductDetails'
  count1      Int      @default(0) // Generic counter 1 (e.g., Tokens In)
  count2      Int      @default(0) // Generic counter 2 (e.g., Tokens Out)
  durationMs  Int      @default(0) // Execution time
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([category, provider])
}
