# ============================================================================
# TROVES PRODUCTION RUNNER DOCKERFILE
# ============================================================================
# This Dockerfile is exclusively used for pre-built release distributions.
# It DOES NOT build the SvelteKit app (that happens on the host via bundle.sh).
# It only installs production dependencies and runs the pre-compiled code,
# solving the missing /static crash and keeping the image lean and secure.
# ============================================================================

FROM node:22-bookworm-slim AS runner

# 1. Install required system libraries for media processing (Poppler, FFmpeg, Canvas, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends --fix-missing \
    poppler-utils \
    ffmpeg \
    python3 \
    wget \
    ca-certificates \
    build-essential \
    libcairo2-dev \
    libpango1.0-dev \
    libjpeg-dev \
    libgif-dev \
    librsvg2-dev \
 && wget -q --tries=3 https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -O /usr/local/bin/yt-dlp \
 && chmod a+rx /usr/local/bin/yt-dlp \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 2. Copy dependency manifests and install ONLY production packages
COPY package*.json ./
COPY prisma ./prisma/
# The prisma CLI is a devDependency, so we explicitly install it to generate the binary client and run migrations on boot
RUN npm ci --omit=dev && npm install prisma@^5.0.0 && npx prisma generate

# 3. Copy the pre-built application from the distribution bundle
COPY build ./build
COPY server.js ./

EXPOSE 3000
ENV NODE_ENV=production
ENV PORT=3000

# 4. Push database schema changes (if any) and start the server
CMD ["sh", "-c", "npx prisma db push && node server.js"]
