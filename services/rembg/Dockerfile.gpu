# ==========================================
# GPU-Accelerated RemBG Dockerfile
# ==========================================
FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV OMP_NUM_THREADS=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-setuptools \
    python-is-python3 \
    curl \
    git \
    libgomp1 \
 && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --no-cache-dir "onnxruntime-gpu<1.27" "rembg[cli]" fastapi uvicorn python-multipart --break-system-packages && \
    python -m pip uninstall -y onnxruntime || true && \
    rm -f /usr/local/lib/python3.12/dist-packages/onnxruntime/capi/libonnxruntime_providers_tensorrt*

# Expose Python wheel NVIDIA libraries to the C++ ONNX loader
ENV LD_LIBRARY_PATH="/usr/local/lib/python3.12/dist-packages/nvidia/cublas/lib:/usr/local/lib/python3.12/dist-packages/nvidia/cudnn/lib:/usr/local/lib/python3.12/dist-packages/onnxruntime/capi:${LD_LIBRARY_PATH}"

RUN rembg d bria-rmbg && rembg d u2net

WORKDIR /app
COPY server.py /app/server.py

EXPOSE 7000
CMD ["python3", "server.py"]