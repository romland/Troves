# ==========================================
# CORE APPLICATION & DATABASE
# ==========================================
DATABASE_URL="file:./dev.db?connection_limit=1"
PORT=3000
BODY_SIZE_LIMIT=52428800
ENABLE_LLM_SANDBOX="false"
SELF_DESTROYING_SW="true"

# ==========================================
# DOCKER & LOCAL MICROSERVICES
# ==========================================
DOCKER_MODE="false"
ENABLE_REMBG="true"
ENABLE_PADDLEOCR="true"
ENABLE_SINGLEFILE="true"

# Service endpoints (override when running containerized or on another host)
REMBG_URL="http://localhost:7000"
PADDLE_URL="http://localhost:8000"
SINGLEFILE_URL="http://localhost:8001"

# ==========================================
# BASE CREDENTIALS (FALLBACK)
# ==========================================
# If specific AI_*_API_KEY variables below are left blank,
# the system automatically falls back to these tokens.
GEMINI_API_KEY="AQ...."
GROQ_API_TOKEN="gsk_..."
OPENAI_API_TOKEN="sk-..."

# ==========================================
# AI ENGINES: DEFAULT CONFIGURATION
# ==========================================
# Supported providers: "gemini" (Google Native SDK), "groq", "openai" (OpenAI-compatible)
# Leave BASE_URL blank for official cloud endpoints. Set only for local runners (e.g., Ollama).

# --- 1. VISION ENGINE (Classification, Multi-Scan, Visual Inspection) ---
AI_VISION_PROVIDER="gemini"
AI_VISION_MODEL="gemini-3.1-flash-lite"
AI_VISION_BASE_URL=""
AI_VISION_API_KEY=""

# Optional Vision Overrides:
# AI_VISION_MULTISCAN_PROVIDER="gemini"
# AI_VISION_MULTISCAN_MODEL="gemini-3.1-flash-lite"
# AI_VISION_CLASSIFY_PROVIDER="gemini"
# AI_VISION_GUESS_PROVIDER="gemini"

# --- 2. TEXT ENGINE (Baseline: Q&A, Taxonomy Generation, KVP Extraction) ---
AI_TEXT_PROVIDER="gemini"
AI_TEXT_MODEL="gemini-3.1-flash-lite"
AI_TEXT_BASE_URL=""
AI_TEXT_API_KEY=""

# --- 2a. TEXT OVERRIDE: Webpage & Document Summaries ---
AI_TEXT_SUMMARY_PROVIDER="groq"
AI_TEXT_SUMMARY_MODEL="openai/gpt-oss-20b"
AI_TEXT_SUMMARY_BASE_URL=""
AI_TEXT_SUMMARY_API_KEY=""

# --- 2b. TEXT OVERRIDE: Data Parsers (Invoices, Receipts, Reverse Image Search) ---
AI_TEXT_PARSER_PROVIDER="groq"
AI_TEXT_PARSER_MODEL="openai/gpt-oss-20b"
AI_TEXT_PARSER_BASE_URL=""
AI_TEXT_PARSER_API_KEY=""

# --- 2c. TEXT OVERRIDE: Q&A (Ask Troves Assistant) ---
# AI_TEXT_QNA_PROVIDER="gemini"
# AI_TEXT_QNA_MODEL="gemini-3.1-flash-lite"

# --- 2d. TEXT OVERRIDE: Taxonomy & EAV Architecture ---
# AI_TEXT_TAXONOMY_PROVIDER="gemini"
# AI_TEXT_TAXONOMY_MODEL="gemini-3.1-flash-lite"

# --- 3. AUDIO ENGINE (Voice Search & Dictation Transcription) ---
AI_AUDIO_PROVIDER="groq"
AI_AUDIO_MODEL="whisper-large-v3-turbo"
AI_AUDIO_BASE_URL=""
AI_AUDIO_API_KEY=""
